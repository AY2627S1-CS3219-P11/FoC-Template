discovery.docker "foc" {
  host = "unix:///var/run/docker.sock"
  refresh_interval = "5s"

  filter {
    name = "label"
    values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT_NAME")]
  }
}

discovery.relabel "foc" {
  targets = discovery.docker.foc.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex = "user-service|supplier-service|order-service|credit-service|internal-gateway|ui|rabbitmq|gateway-demo"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label = "service_name"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label = "compose_project"
  }
}

loki.source.docker "foc" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.relabel.foc.output
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
