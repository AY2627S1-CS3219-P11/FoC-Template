# Local Docker Compose database settings. DATABASE_URL is derived from these by compose.yaml.
# Do not use these values in production.
POSTGRES_DB=supplier
POSTGRES_USER=supplier
POSTGRES_PASSWORD=supplier
INTERNAL_GATEWAY_URL=http://internal-gateway
RABBITMQ_URL=

AUTH_PROVIDER=legacy
KEYCLOAK_ISSUER=http://localhost:8080/realms/foc
KEYCLOAK_AUDIENCE=foc-api
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/foc/protocol/openid-connect/certs
