# Host-run application settings; export these before starting uvicorn.
# Root Compose instead reads SUPPLIER_DATABASE_URL and RABBITMQ_URL from root .env.
DATABASE_URL=
RABBITMQ_URL=amqp://foc:change-me-local-broker@localhost:5672

# Token verification requires no identity administration credentials.
KEYCLOAK_ISSUER=http://localhost:8080/realms/foc
KEYCLOAK_AUDIENCE=foc-api
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/foc/protocol/openid-connect/certs
