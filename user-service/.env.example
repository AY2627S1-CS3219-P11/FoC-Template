DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
ACCESS_TOKEN_SECRET=
INTERNAL_GATEWAY_URL=http://internal-gateway
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
RABBITMQ_URL=

# Use the same provider and API client secret across both services.
AUTH_PROVIDER=keycloak
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=foc
KEYCLOAK_BACKEND_CLIENT_ID=foc-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=
KEYCLOAK_ISSUER=http://localhost:8080/realms/foc
KEYCLOAK_AUDIENCE=foc-api
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/foc/protocol/openid-connect/certs

# Token introspection only; no identity administration permissions.
KEYCLOAK_API_CLIENT_ID=foc-api
KEYCLOAK_API_CLIENT_SECRET=
