# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=
# HTTP peers share one origin; routing and peer addresses belong to the gateway.
INTERNAL_GATEWAY_URL=http://internal-gateway

# ---- Internal gateway (origins only, without path prefixes) ---
USER_SERVICE_UPSTREAM=http://user-service:5005
SUPPLIER_SERVICE_UPSTREAM=http://supplier-service:3001
# These are deployment settings, not application assumptions.
NGINX_DNS_RESOLVER=127.0.0.11

# ---- Keycloak (local development only) ------------------------
# Used by root Compose and by keycloak/compose.yaml with --env-file .env.
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-local-keycloak-db
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-keycloak-admin

# ---- Backend authentication migration ------------------------
# Set legacy only when running the original cookie-based UI and backends.
AUTH_PROVIDER=keycloak
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=foc
KEYCLOAK_BACKEND_CLIENT_ID=foc-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=change-me-local-backend-client
KEYCLOAK_ISSUER=http://localhost:8080/realms/foc
KEYCLOAK_AUDIENCE=foc-api
# Root Compose backends use Docker DNS; host-run backends use localhost instead.
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/foc/protocol/openid-connect/certs

# ---- Auth / JWT -----------
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# ... Add more variables as needed

# Token introspection only; no identity administration permissions.
KEYCLOAK_API_CLIENT_ID=foc-api
KEYCLOAK_API_CLIENT_SECRET=change-me-local-api-client
