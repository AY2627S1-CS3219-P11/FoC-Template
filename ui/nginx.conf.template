server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    resolver ${NGINX_DNS_RESOLVER} valid=10s ipv6=off;
    set $internal_gateway "${INTERNAL_GATEWAY_URL}";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_cookie_domain ~.* $host;

    # Keep the service prefixes; only the internal gateway strips them.
    location /user-api/ {
        proxy_pass $internal_gateway$request_uri;
    }

    location /supplier-api/ {
        proxy_pass $internal_gateway$request_uri;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
