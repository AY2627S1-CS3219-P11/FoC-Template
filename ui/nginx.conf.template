log_format json_access escape=json
    '{"timestamp":"$time_iso8601","service_name":"ui",'
    '"message":"http.request_completed","http_request_id":"$request_id",'
    '"method":"$request_method","status":$status,"duration_seconds":$request_time,'
    '"upstream_status":"$upstream_status","upstream_seconds":"$upstream_response_time"}';

server {
    access_log /dev/stdout json_access;
    error_log /dev/stderr warn;
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    resolver ${NGINX_DNS_RESOLVER} valid=10s ipv6=off;
    set $internal_gateway "${INTERNAL_GATEWAY_URL}";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Generate at the public entry point; preserve across internal service calls.
    proxy_set_header X-Request-ID $request_id;
    proxy_hide_header X-Request-ID;
    add_header X-Request-ID $request_id always;
    proxy_cookie_domain ~.* $host;

    # Keep the service prefixes; only the internal gateway strips them.
    location /user-api/ {
        proxy_pass $internal_gateway$request_uri;
    }

    location /supplier-api/ {
        proxy_pass $internal_gateway$request_uri;
    }

    location /order-api/ {
        proxy_pass $internal_gateway$request_uri;
    }

    location /credit-api/ {
        proxy_pass $internal_gateway$request_uri;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
